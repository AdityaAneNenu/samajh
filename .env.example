# ---------------------------------------------------------------------------
# Samajh — environment configuration
#
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored. NEVER commit real credentials.
#
# Every value here is read on the SERVER only. No AI credential is ever sent
# to the browser.
#
# Fastest way to see the app work: set AI_PROVIDER=mock and leave everything
# else blank. That runs the whole flow offline with no key.
# ---------------------------------------------------------------------------

# Which AI implementation the app talks to.
#   `openai-compatible` — any provider that speaks POST /chat/completions
#                          (Groq, Together, Fireworks, OpenRouter, DeepInfra,
#                           Hugging Face Inference Providers, vLLM, llama.cpp
#                           server, LM Studio, ...)
#   `mock`               — deterministic offline provider. Needs no key. Used
#                          by the test suite, and useful for seeing the flow
#                          before you configure anything.
AI_PROVIDER=openai-compatible

# Base URL of the OpenAI-compatible endpoint (no trailing slash).
# Required when AI_PROVIDER=openai-compatible.
AI_BASE_URL=https://your-provider.example.com/v1

# Model id exactly as your provider names it. Pick an open-weight model —
# see README "Model selection" for the licence of each family. No model id is
# hard-coded anywhere in this project, and no provider has been assumed.
AI_MODEL=your-open-weight-model-id

# Your provider API key. Server-side only. Never sent to the browser and
# scrubbed from provider error bodies before anything is logged.
AI_API_KEY=your_api_key_here

# Set to `true` only if AI_MODEL is a vision-capable model that can read images
# through the chat-completions API. When false, the reader accepts text only and
# the interface says so instead of offering a photo box that cannot work.
AI_SUPPORTS_IMAGES=false

# Request budget and retry behaviour.
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2

# Hard ceiling on how much document text is sent to the model, in characters.
# Keeps token cost, latency and data exposure bounded. Default: 24000.
AI_MAX_INPUT_CHARS=24000

# How to ask for structured output.
#   `auto`        — send response_format and, if the server rejects the field,
#                   stop sending it for the life of the process (default).
#   `json_object` — always send it.
#   `off`         — never send it. Use for servers that cannot accept it.
AI_JSON_MODE=auto