# ---------------------------------------------------------------------------
# Samajh — environment configuration
#
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored. NEVER commit real credentials.
#
# All values here are read on the SERVER only. No AI credential is ever sent
# to the browser.
# ---------------------------------------------------------------------------

# Which AI implementation the app talks to.
#   `openai-compatible` — any provider that speaks POST /chat/completions
#                          (Groq, Together, Fireworks, OpenRouter, DeepInfra,
#                           Hugging Face Inference Providers, vLLM, llama.cpp
#                           server, LM Studio, ...)
#   `mock`               — deterministic offline provider. Used by the test
#                          suite and for UI development without a key.
AI_PROVIDER=openai-compatible

# Base URL of the OpenAI-compatible endpoint (no trailing slash).
AI_BASE_URL=https://your-provider.example.com/v1

# Model id as the provider names it. See README "Model selection" for the
# models this project has been verified against and their exact licences.
AI_MODEL=your-open-weight-model-id

# Your provider API key. Server-side only.
AI_API_KEY=your_api_key_here

# Request budget and retry behaviour.
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2

# Hard ceiling on how much document text is sent to the model, in characters.
# Keeps token cost, latency and data exposure bounded. Default: 24000.
AI_MAX_INPUT_CHARS=24000